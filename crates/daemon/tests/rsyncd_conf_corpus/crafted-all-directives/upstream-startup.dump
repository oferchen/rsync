load=OK
[global]
bind_address=127.0.0.1
daemon_chroot=/srv/chroot
daemon_gid=0
daemon_uid=0
motd_file=/etc/rsyncd.motd
pid_file=/run/rsyncd.pid
proxy_protocol_hosts=127.0.0.1
socket_options=SO_KEEPALIVE
listen_backlog=7
rsync_port=8873
proxy_protocol=1
auth_digest=sha256
auth_users=alice
charset=utf-8
comment=global comment
dont_compress=*.gz *.zip
early_exec=/bin/true
exclude=*.tmp
exclude_from=/etc/rsync.exclude
filter=- *.bak
gid=0
hosts_allow=10.0.0.0/8
hosts_deny=10.9.9.9
include=*.keep
include_from=/etc/rsync.include
incoming_chmod=Dg+s
lock_file=/run/rsyncd.lock
log_file=/var/log/rsyncd.log
log_format=%o %f
name=ignored
name_converter=/bin/cat
outgoing_chmod=Fo-w
postxfer_exec=/bin/true
prexfer_exec=/bin/true
refuse_options=delete
secrets_file=/etc/rsyncd.secrets
syslog_tag=oc-global
uid=0
path=/srv/global
temp_dir=/tmp
max_connections=3
max_verbosity=2
timeout=60
syslog_facility=152
fake_super=1
forward_lookup=0
ignore_errors=1
ignore_nonreadable=1
insecure_links=1
list=0
read_only=0
reverse_lookup=0
strict_modes=0
transfer_logging=1
write_only=1
munge_symlinks=0
numeric_ids=1
open_noatime=1
use_chroot=0
